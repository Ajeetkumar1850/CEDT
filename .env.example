# Environment
NODE_ENV=development

# Transfer Configuration
CHUNK_SIZE=4194304

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/cedtp

# Pinecone Configuration (Vector Store for RAG)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=malware-signatures

# API Server
API_PORT=3000

# Receiver Configuration
RECEIVER_PORT=9000

# Logging
LOG_LEVEL=info
